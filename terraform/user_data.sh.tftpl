#!/bin/bash
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

mkdir -p /opt/uptime-control-room
cat > /opt/uptime-control-room/app.env <<EOF
AWS_REGION=${aws_region}
S3_BUCKET_NAME=${log_bucket_name}
HOST=0.0.0.0
EOF

docker pull ${docker_image}
docker rm -f uptime-control-room || true
docker run -d \
  --name uptime-control-room \
  --restart unless-stopped \
  --env-file /opt/uptime-control-room/app.env \
  -p 80:3000 \
  ${docker_image}
